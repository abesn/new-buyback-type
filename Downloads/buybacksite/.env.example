# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Railway
# Railway: Settings → Variables → DATABASE_URL (auto-injected if you add a Postgres service)
DATABASE_URL="postgresql://user:password@host:5432/buybacksite?sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection string from Railway
# Railway: Add a Redis service → Variables → REDIS_URL (auto-injected)
REDIS_URL="redis://default:password@host:6379"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# Your platform's base URL — no trailing slash
# Dev: http://localhost:3000
# Prod: https://app.buybacksite.com  (or your platform root domain)
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Magic Link Login) ─────────────────────────────────────────────────
# Option A: Resend SMTP (recommended — free tier: 3,000 emails/month)
#   Host: smtp.resend.com  Port: 587  User: resend  Pass: your-resend-api-key
#
# Option B: Any SMTP provider (Gmail, Postmark, Mailgun, etc.)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="BuyBackSite <no-reply@yourdomain.com>"

# ─── Platform Domain ──────────────────────────────────────────────────────────
# The root domain of your SaaS platform
# Tenants get subdomains: {slug}.buybacksite.com
# Used by middleware for subdomain parsing and by tenant.ts helpers
NEXT_PUBLIC_ROOT_DOMAIN="buybacksite.com"

# ─── Cloudflare SSL for SaaS ──────────────────────────────────────────────────
# Only needed when you're ready to enable custom domain mapping via Cloudflare
# Dashboard: cloudflare.com → your zone → SSL/TLS → Custom Hostnames
#
# Zone ID: Cloudflare dashboard → Overview → right sidebar
CLOUDFLARE_ZONE_ID="your-zone-id"
#
# API Token: cloudflare.com → Profile → API Tokens → Create Token
# Permissions needed: Zone → SSL and Certificates → Edit
CLOUDFLARE_API_TOKEN="your-api-token"

# ─── eBay Pricing API ─────────────────────────────────────────────────────────
# Used by the pricing sync background job (Module 3)
# Register at: developer.ebay.com → Get an App ID
EBAY_APP_ID="YourApp-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
EBAY_CERT_ID="your-cert-id"
EBAY_DEV_ID="your-dev-id"

# ─── Shipping Labels ──────────────────────────────────────────────────────────
# EasyPost — used to generate pre-paid return shipping labels
# Register at: easypost.com → API Keys
EASYPOST_API_KEY="EZTKxxxxxxxxxxxxxxxxxx"

# ─── Stripe (Billing — Module 8) ─────────────────────────────────────────────
# Charge your clients their monthly subscription
# Dashboard: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ─── Sentry (Error Monitoring — Module 8) ────────────────────────────────────
# Free tier covers everything you need at launch
# dashboard.sentry.io → New Project → Next.js
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
