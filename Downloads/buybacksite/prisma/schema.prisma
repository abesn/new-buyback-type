// Prisma Schema — BuyBack SaaS Platform
// Multi-tenant: every tenant-scoped table has tenantId + index from day one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Required Tables ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(STAFF)
  tenantId      String?

  accounts Account[]
  sessions Session[]
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
}

enum UserRole {
  PLATFORM_ADMIN // You — can see all tenants
  TENANT_ADMIN   // Buyback shop owner — full access to their tenant
  STAFF          // Processes orders only — no settings access
}

// ─── Tenants ──────────────────────────────────────────────────────────────────

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique // subdomain: {slug}.buybacksite.com
  plan   TenantPlan   @default(STARTER)
  status TenantStatus @default(TRIAL)

  // Stripe billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  trialEndsAt          DateTime?

  // Relations
  users                User[]
  napSettings          NapSettings?
  domainSettings       DomainSettings?
  scriptInjection      ScriptInjection?
  pricingRules         PricingRule[]
  buybackPrices        BuybackPrice[]
  tenantDeviceSettings TenantDeviceSettings[]
  orders               Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

enum TenantPlan {
  STARTER // $97/mo — up to 50 transactions
  GROWTH  // $147/mo — unlimited, full catalog
  PRO     // $247/mo — white-label, analytics, integrations
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

// ─── Tenant Settings ──────────────────────────────────────────────────────────

// NAP = Name, Address, Phone — injected into every public page for local SEO
model NapSettings {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  businessName  String
  streetAddress String
  city          String
  state         String
  zipCode       String
  phone         String
  serviceArea   String? // "Chicago metro, Cook County"
  hoursJson     String? @db.Text // JSON: {"mon":"9am-6pm","tue":"9am-6pm",...}
  googleMapsUrl String?
  facebookUrl   String?
  instagramUrl  String?
  latitude      Float?
  longitude     Float?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// Custom domain mapping — client points their domain to proxy.buybacksite.com
model DomainSettings {
  id            String       @id @default(cuid())
  tenantId      String       @unique
  customDomain  String?      @unique // "chicagophonebuyback.com"
  domainStatus  DomainStatus @default(PENDING)
  cfHostnameId  String?      // Cloudflare custom hostname ID for API management
  verifiedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([customDomain])
  @@index([domainStatus])
}

enum DomainStatus {
  PENDING    // Not yet configured
  VERIFYING  // DNS records added, waiting for Cloudflare
  ACTIVE     // Live and serving traffic
  ERROR      // Verification failed — check DNS
}

// Script injection — admin-only, audit-logged
model ScriptInjection {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  headScripts   String? @db.Text // Raw HTML injected before </head>
  footerScripts String? @db.Text // Raw HTML injected before </body>
  updatedBy     String? // userId of last editor
  updatedByEmail String? // email of last editor (for display)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// ─── Pricing Rules ────────────────────────────────────────────────────────────
// Hierarchy: GLOBAL → CATEGORY → BRAND → MODEL (most specific wins)

model PricingRule {
  id            String           @id @default(cuid())
  tenantId      String
  scope         PricingRuleScope @default(GLOBAL)
  scopeId       String?          // categoryId, brandId, or modelId
  marginPercent Float            // 0.65 = pay 65% of current market value

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, scope, scopeId])
  @@index([tenantId])
}

enum PricingRuleScope {
  GLOBAL   // Fallback for all devices
  CATEGORY // Override for a device category
  BRAND    // Override for a brand
  MODEL    // Override for a specific model
}

// ─── Device Catalog ───────────────────────────────────────────────────────────

model DeviceCategory {
  id        String  @id @default(cuid())
  name      String  // "Smartphone"
  slug      String  @unique // "smartphone"
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  brands DeviceBrand[]

  @@index([active])
}

model DeviceBrand {
  id         String  @id @default(cuid())
  categoryId String
  name       String  // "Apple"
  slug       String  @unique // "apple"
  logoUrl    String?
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  category DeviceCategory @relation(fields: [categoryId], references: [id])
  models   DeviceModel[]

  @@index([categoryId])
  @@index([active])
}

model DeviceModel {
  id          String  @id @default(cuid())
  brandId     String
  name        String  // "iPhone 15 Pro Max"
  slug        String  @unique // "iphone-15-pro-max"
  releaseYear Int?
  imageUrl    String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  brand          DeviceBrand            @relation(fields: [brandId], references: [id])
  variants       DeviceVariant[]
  tenantSettings TenantDeviceSettings[]

  @@index([brandId])
  @@index([active])
  @@index([slug])
}

model DeviceVariant {
  id        String  @id @default(cuid())
  modelId   String
  storageGb Int     // 64, 128, 256, 512, 1024
  carrier   Carrier @default(UNLOCKED)
  skuCode   String  @unique // "iph15pm-256-unl"
  active    Boolean @default(true)

  model         DeviceModel    @relation(fields: [modelId], references: [id])
  buybackPrices BuybackPrice[]
  marketPrice   MarketPrice?
  orderItems    OrderItem[]

  @@unique([modelId, storageGb, carrier])
  @@index([modelId])
  @@index([active])
}

enum Carrier {
  UNLOCKED
  ATT
  TMOBILE
  VERIZON
  SPRINT
  OTHER
}

// Shared condition grades — same 4 grades apply to every device
model DeviceCondition {
  id          String  @id @default(cuid())
  grade       String  @unique // "A", "B", "C", "D"
  label       String  // "Excellent", "Good", "Fair", "Broken"
  description String  // Shown to seller during quote
  multiplier  Float   // Applied to Grade A price: 1.0, 0.75, 0.50, 0.15
  sortOrder   Int     @default(0)

  buybackPrices BuybackPrice[]
  orderItems    OrderItem[]
}

// ─── Prices ───────────────────────────────────────────────────────────────────

// The core pricing table — one row per tenant × variant × condition
// Composite index on (tenantId, variantId, conditionId) for fast quote lookups
model BuybackPrice {
  id            String  @id @default(cuid())
  tenantId      String
  variantId     String
  conditionId   String
  buyPrice      Decimal @db.Decimal(10, 2) // What the shop pays the seller
  marketValue   Decimal @db.Decimal(10, 2) // Current eBay comp (for feed + display)
  marginPercent Float   // Recorded at calculation time
  manualOverride Boolean @default(false)  // True = skip on next price sync

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant   DeviceVariant   @relation(fields: [variantId], references: [id])
  condition DeviceCondition @relation(fields: [conditionId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([tenantId, variantId, conditionId])
  @@index([tenantId])
  @@index([variantId])
  @@index([updatedAt])
}

// Price history — written every time the sync job updates prices
model PriceHistory {
  id            String   @id @default(cuid())
  tenantId      String
  variantId     String
  conditionId   String
  buyPrice      Decimal  @db.Decimal(10, 2)
  marketValue   Decimal  @db.Decimal(10, 2)
  recordedAt    DateTime @default(now())

  @@index([tenantId, variantId, conditionId])
  @@index([recordedAt])
}

// Raw market data from eBay — shared across all tenants (not per-tenant)
model MarketPrice {
  id           String   @id @default(cuid())
  variantId    String   @unique
  avgSalePrice Decimal  @db.Decimal(10, 2)
  minSalePrice Decimal  @db.Decimal(10, 2)
  maxSalePrice Decimal  @db.Decimal(10, 2)
  sampleSize   Int      // Number of eBay sold listings used
  source       String   @default("ebay")
  fetchedAt    DateTime @default(now())

  variant DeviceVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([fetchedAt])
}

// ─── Tenant Device Settings ───────────────────────────────────────────────────

// Allows tenants to deactivate categories, brands, or models from their wizard
model TenantDeviceSettings {
  id       String  @id @default(cuid())
  tenantId String
  modelId  String
  active   Boolean @default(true) // false = hidden from this tenant's quote wizard

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  DeviceModel @relation(fields: [modelId], references: [id])

  @@unique([tenantId, modelId])
  @@index([tenantId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  variantId   String
  conditionId String
  quotedPrice Decimal  @db.Decimal(10, 2)
  finalPrice  Decimal? @db.Decimal(10, 2)

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   DeviceVariant   @relation(fields: [variantId], references: [id])
  condition DeviceCondition @relation(fields: [conditionId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Order {
  id          String @id @default(cuid())
  tenantId    String
  orderNumber String @unique // Human-readable: BB-2025-0001

  // Seller info
  sellerName  String
  sellerEmail String
  sellerPhone String?
  sellerCity  String? // For analytics

  // Devices — stored in OrderItem rows (one per device)
  // Legacy single-device fields kept nullable for backward compatibility
  variantId   String?
  conditionId String?
  deviceNotes String? @db.Text // Any notes seller added about device condition

  // Pricing
  quotedPrice Decimal  @db.Decimal(10, 2) // Price shown at quote acceptance
  finalPrice  Decimal? @db.Decimal(10, 2) // After inspection (may differ)

  // Payout
  payoutMethod    PayoutMethod
  payoutAddress   String? // PayPal email, Zelle number, mailing address
  payoutReference String? // Transaction ID, check number
  paidAt          DateTime?

  // Shipping
  shippingLabelUrl String?
  trackingNumber   String?
  carrierName      String? // USPS, FedEx, UPS
  shippedAt        DateTime?
  receivedAt       DateTime?

  // Status
  status OrderStatus @default(PENDING)

  // Internal
  internalNotes   String? @db.Text
  rejectionReason String?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@index([sellerEmail])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String? // userId

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PENDING        // Quote accepted, awaiting shipment from seller
  SHIPPED        // Seller has shipped, awaiting arrival
  RECEIVED       // Device arrived at shop
  INSPECTING     // Under inspection
  OFFER_REVISED  // Revised offer sent — condition differs from claim
  APPROVED       // Inspection passed, payout queued
  PAID           // Payout sent to seller
  REJECTED       // Device rejected (stolen, wrong item, too damaged)
  RETURNED       // Rejected device shipped back to seller
  CANCELLED      // Cancelled before shipment
}

enum PayoutMethod {
  PAYPAL
  ZELLE
  VENMO
  CHECK
  ACH
  STORE_CREDIT
}
